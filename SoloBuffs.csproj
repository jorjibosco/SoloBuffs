<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SoloBuffs</AssemblyName>
    <RootNamespace>SoloBuffs</RootNamespace>
    <!--
      Place your BepInEx interop and core folders one level above this project:
        ParentFolder\
          SoloBuffs\    <- this project
          interop\      <- from BepInEx\interop
          core\         <- from BepInEx\core
    -->
    <InteropDir>..\interop</InteropDir>
    <CoreDir>..\core</CoreDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- VampireCommandFramework via NuGet -->
    <PackageReference Include="VRising.VampireCommandFramework" Version="0.10.*" />

    <!-- BepInEx 6 (IL2CPP) -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(CoreDir)\BepInEx.Core.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(CoreDir)\BepInEx.Unity.IL2CPP.dll</HintPath>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(CoreDir)\Il2CppInterop.Runtime.dll</HintPath>
    </Reference>

    <!-- Harmony -->
    <Reference Include="HarmonyLib">
      <HintPath>$(CoreDir)\0Harmony.dll</HintPath>
    </Reference>

    <!-- UnityEngine -->
    <Reference Include="UnityEngine">
      <HintPath>$(InteropDir)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(InteropDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>

    <!-- DOTS -->
    <Reference Include="Unity.Entities">
      <HintPath>$(InteropDir)\Unity.Entities.dll</HintPath>
    </Reference>
    <Reference Include="Unity.Transforms">
      <HintPath>$(InteropDir)\Unity.Transforms.dll</HintPath>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(InteropDir)\Unity.Mathematics.dll</HintPath>
    </Reference>
    <Reference Include="Unity.Collections">
      <HintPath>$(InteropDir)\Unity.Collections.dll</HintPath>
    </Reference>

    <!-- Game assemblies -->
    <Reference Include="ProjectM">
      <HintPath>$(InteropDir)\ProjectM.dll</HintPath>
    </Reference>
    <Reference Include="ProjectM.Shared">
      <HintPath>$(InteropDir)\ProjectM.Shared.dll</HintPath>
    </Reference>
    <Reference Include="ProjectM.Gameplay.Systems">
      <HintPath>$(InteropDir)\ProjectM.Gameplay.Systems.dll</HintPath>
    </Reference>
    <Reference Include="ProjectM.CodeGeneration">
      <HintPath>$(InteropDir)\ProjectM.CodeGeneration.dll</HintPath>
    </Reference>
    <Reference Include="Stunlock.Core">
      <HintPath>$(InteropDir)\Stunlock.Core.dll</HintPath>
    </Reference>

    <!-- Il2Cpp base -->
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(InteropDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(InteropDir)\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(InteropDir)\Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>